{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rootDir": "..",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "paths": {
      "src/*": ["../src/*"]
    }
  },
  "references": [{ "path": ".." }]
}
